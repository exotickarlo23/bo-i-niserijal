---
/**
 * Video epizode. Prvi popunjeni (TikTok → Instagram → YouTube) se ugrađuje,
 * ostali se nude kao poveznice. Bez ijednog videa sekcija se ne prikazuje.
 */
import type { Video } from '../lib/video';

interface Props {
  videi: Video[];
  naziv: string;
}

const { videi, naziv } = Astro.props;

const glavni = videi.find((v) => v.embed) ?? null;
const ostali = videi.filter((v) => v !== glavni);

/** "A", "A i B", "A, B i C" */
function spoji<T>(popis: T[]): { stavka: T; razdvojnik: string }[] {
  return popis.map((stavka, i) => ({
    stavka,
    razdvojnik: i === popis.length - 1 ? '' : i === popis.length - 2 ? ' i ' : ', ',
  }));
}
---

{
  videi.length > 0 && (
    <section class="video" aria-labelledby="video-naslov">
      <h2 class="video__naslov" id="video-naslov">
        Pogledaj <em>epizodu</em>
      </h2>

      {glavni && glavni.embed && (
        <div class:list={['video__okvir', `video__okvir--${glavni.platforma}`, { 'video__okvir--uspravno': glavni.uspravno }]}>
          <iframe
            src={glavni.embed}
            title={`${naziv}: video epizode (${glavni.platforma === 'tiktok' ? 'TikTok' : glavni.platforma === 'instagram' ? 'Instagram' : 'YouTube'})`}
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
          />
        </div>
      )}

      {ostali.length > 0 && (
        <p class="video__poveznice">
          {glavni ? 'Video je i na ' : 'Pogledaj video na '}
          {spoji(ostali).map(({ stavka, razdvojnik }) => (
            <>
              <a href={stavka.url} target="_blank" rel="noopener">
                {stavka.naziv}
              </a>
              {razdvojnik}
            </>
          ))}
          .
        </p>
      )}
    </section>
  )
}

<style>
  .video {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .video__naslov {
    font-size: clamp(1.5rem, 5vw, 2rem);
    text-align: center;
  }

  .video__naslov em {
    color: var(--crvena);
  }

  .video__okvir {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--krem-tamna);
    box-shadow:
      0 0 0 var(--okvir-linija) var(--zlatna-55),
      0 0 0 0.6rem var(--krem),
      0 0 0 calc(0.6rem + var(--okvir-linija)) var(--zlatna-30);
  }

  .video__okvir--uspravno {
    width: min(100%, 21rem);
    aspect-ratio: 9 / 16;
  }

  /* Instagramov ugrađeni prikaz ima zaglavlje i podnožje oko videa */
  .video__okvir--instagram {
    width: min(100%, 23rem);
    aspect-ratio: auto;
    height: min(46rem, calc(min(100vw, 23rem) * 16 / 9 + 9rem));
  }

  .video__okvir iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__poveznice {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--tekst-blagi);
    text-align: center;
  }

  .video__poveznice a {
    color: var(--crvena);
    font-weight: 700;
  }
</style>
