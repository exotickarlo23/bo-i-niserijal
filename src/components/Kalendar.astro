---
/**
 * Adventski kalendar: 13 kućica različitih veličina.
 *
 * Raspored kućica zadan je u CSS-u (grid-template-areas) za mobitel, tablet i
 * računalo. Kućice se slažu po redoslijedu datuma (k0 = najava, k1 = prvi kolač ...).
 * Zaključavanje po datumu i pamćenje otvorenih vratašca rade u pregledniku
 * (skripta na dnu), jer je stranica statična.
 */
import Slika from './Slika.astro';
import Zvijezda from './Zvijezda.astro';
import { formatirajDatum } from '../lib/datumi';
import type { Epizoda } from '../lib/epizode';

interface Props {
  epizode: Epizoda[];
}

const { epizode } = Astro.props;
---

<div class="kalendar-omot">
  <ol class="kalendar" aria-label="Adventski kalendar">
    {
      epizode.map((e) => {
        const otvara = formatirajDatum(e.datum);
        return (
          <li
            class:list={[
              'kucica',
              e.indeks % 2 === 0 ? 'kucica--crvena' : 'kucica--zelena',
              { 'kucica--uvod': e.vrsta === 'uvod' },
            ]}
            style={`grid-area: k${e.indeks}`}
            data-datum={e.datum}
            data-kljuc={e.kljuc}
            data-otvara={otvara}
          >
            <div class="kucica__unutra" id={`unutra-${e.kljuc}`} hidden>
              <a class="kucica__poveznica" href={e.url} tabindex="-1">
                <Slika
                  put={e.slika}
                  naziv={e.naziv}
                  alt={e.slikaAlt || e.naziv}
                  sizes={
                    e.vrsta === 'uvod'
                      ? '(min-width: 64em) 360px, 66vw'
                      : '(min-width: 64em) 360px, (min-width: 40em) 50vw, 66vw'
                  }
                  class="kucica__slika"
                />
                <span class="kucica__naziv">{e.naziv}</span>
              </a>
            </div>

            <div class="kucica__scena">
              <button
                type="button"
                class="kucica__vrata"
                aria-controls={`unutra-${e.kljuc}`}
                aria-expanded="false"
                aria-label={`${otvara}: vratašca`}
              >
                <span class="vrata__lice">
                  <span class="vrata__broj">{e.dan}</span>
                  <Zvijezda class="vrata__zvijezda" />
                  <span class="vrata__poruka" aria-hidden="true">
                    Otvara se
                    <br />
                    {otvara}
                  </span>
                </span>
                <span class="vrata__nalicje" aria-hidden="true" />
              </button>
            </div>
          </li>
        );
      })
    }
  </ol>
  <p class="sr-only" aria-live="polite" id="kalendar-obavijest"></p>
  <noscript>
    <p class="kalendar__bez-js">
      Za otvaranje vratašca uključi JavaScript. Sve epizode su navedene na stranici
      <a href="/uvod/">najave serijala</a>.
    </p>
  </noscript>
</div>

<script is:inline>
  (function () {
    var d = window.dvanaest;
    if (!d) return;

    // Pregledi (?preview=1, ?datum=...) pamte otvorena vratašca odvojeno od pravog kalendara.
    var KLJUC = d.pregled || d.simulirano ? '12-dana:otvorena-pregled' : '12-dana:otvorena';
    var obavijest = document.getElementById('kalendar-obavijest');
    var smanjeniPokret = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function procitaj() {
      try {
        var v = JSON.parse(localStorage.getItem(KLJUC) || '[]');
        return Array.isArray(v) ? v : [];
      } catch (e) {
        return [];
      }
    }

    function spremi(popis) {
      try {
        localStorage.setItem(KLJUC, JSON.stringify(popis));
      } catch (e) {}
    }

    var otvorena = procitaj();

    function otvori(k, animirano) {
      var vrata = k.querySelector('.kucica__vrata');
      var unutra = k.querySelector('.kucica__unutra');
      var poveznica = k.querySelector('.kucica__poveznica');
      unutra.hidden = false;
      poveznica.removeAttribute('tabindex');
      vrata.setAttribute('aria-expanded', 'true');
      vrata.setAttribute('tabindex', '-1');
      vrata.setAttribute('aria-hidden', 'true');
      if (!animirano) {
        k.classList.add('bez-animacije');
        k.classList.add('otvoreno');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            k.classList.remove('bez-animacije');
          });
        });
        return;
      }
      void unutra.offsetWidth; // pokreni animaciju tek kad je unutrašnjost vidljiva
      k.classList.add('otvoreno');
      poveznica.focus({ preventScroll: true });
    }

    function zatvori(k) {
      var vrata = k.querySelector('.kucica__vrata');
      var unutra = k.querySelector('.kucica__unutra');
      var poveznica = k.querySelector('.kucica__poveznica');
      k.classList.remove('otvoreno');
      poveznica.setAttribute('tabindex', '-1');
      vrata.setAttribute('aria-expanded', 'false');
      vrata.removeAttribute('tabindex');
      vrata.removeAttribute('aria-hidden');
      setTimeout(
        function () {
          if (!k.classList.contains('otvoreno')) unutra.hidden = true;
        },
        smanjeniPokret ? 0 : 950,
      );
    }

    function porukaZakljucano(k) {
      var tekst = 'Ova vratašca otvaraju se ' + k.dataset.otvara + '.';
      obavijest.textContent = '';
      setTimeout(function () {
        obavijest.textContent = tekst;
      }, 50);
      k.classList.remove('poruka');
      void k.offsetWidth;
      k.classList.add('poruka');
      clearTimeout(k._poruka);
      k._poruka = setTimeout(function () {
        k.classList.remove('poruka');
      }, 2600);
    }

    var kucice = document.querySelectorAll('.kucica');
    kucice.forEach(function (k) {
      var datum = k.dataset.datum;
      var vrata = k.querySelector('.kucica__vrata');
      var otkljucano = d.otkljucano(datum);

      k.classList.add(otkljucano ? 'otkljucano' : 'zakljucano');
      vrata.setAttribute(
        'aria-label',
        otkljucano ? 'Otvori vratašca: ' + k.dataset.otvara : k.dataset.otvara + ': zaključano',
      );

      if (otkljucano && otvorena.indexOf(k.dataset.kljuc) !== -1) otvori(k, false);

      vrata.addEventListener('click', function () {
        if (!d.otkljucano(datum)) {
          porukaZakljucano(k);
          return;
        }
        k.classList.remove('zakljucano');
        k.classList.add('otkljucano');
        otvori(k, true);
        if (otvorena.indexOf(k.dataset.kljuc) === -1) {
          otvorena.push(k.dataset.kljuc);
          spremi(otvorena);
        }
      });
    });

    // Način pregleda: gumb za zatvaranje svih vratašca (za ponovno pokazivanje animacije).
    document.addEventListener('click', function (e) {
      if (!e.target.closest || !e.target.closest('#zatvori-vratasca')) return;
      otvorena = [];
      spremi(otvorena);
      kucice.forEach(function (k) {
        if (k.classList.contains('otvoreno')) zatvori(k);
      });
    });
  })();
</script>

<style>
  /* ─── Mreža ─────────────────────────────────────────────────── */

  .kalendar-omot {
    container-type: inline-size;
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
  }

  .kalendar {
    --razmak: clamp(0.45rem, 1.6cqi, 0.95rem);
    --stupci: 3;
    --red: calc((100cqi - (var(--stupci) - 1) * var(--razmak)) / var(--stupci));

    display: grid;
    grid-template-columns: repeat(var(--stupci), minmax(0, 1fr));
    grid-auto-rows: var(--red);
    gap: var(--razmak);
    margin: 0;
    padding: 0;
    list-style: none;

    /*
      Mobitel: 3 stupca. Oznake: k0 = najava (1. 12.), k1 = 2. 12., k2 = 4. 12. ... k12 = 24. 12.
      Najava je jedina kućica 2 × 2; ostale su uske, široke ili visoke.
    */
    grid-template-areas:
      'k0  k0  k7'
      'k0  k0  k7'
      'k1  k4  k4'
      'k6  k3  k9'
      'k6  k2  k9'
      'k5  k5  k10'
      'k8  k12 k10'
      'k8  k12 k11';
  }

  /* Tablet: 4 stupca */
  @container (min-width: 36rem) {
    .kalendar {
      --stupci: 4;
      --red: calc((100cqi - 3 * var(--razmak)) / 4 * 0.86);
      grid-template-areas:
        'k0  k0  k7  k2'
        'k0  k0  k7  k10'
        'k5  k1  k1  k10'
        'k5  k4  k9  k9'
        'k6  k3  k12 k12'
        'k6  k8  k11 k11';
    }
  }

  /* Računalo: 6 stupaca */
  @container (min-width: 54rem) {
    .kalendar {
      --stupci: 6;
      --red: calc((100cqi - 5 * var(--razmak)) / 6 * 0.86);
      grid-template-areas:
        'k0  k0  k7  k4  k4  k10'
        'k0  k0  k7  k9  k1  k1'
        'k5  k8  k8  k9  k12 k6'
        'k5  k2  k11 k11 k12 k3';
    }
  }

  /* ─── Kućica ────────────────────────────────────────────────── */

  .kucica {
    --boja: var(--crvena);
    --boja-tamna: #5e171c;
    position: relative;
    container-type: size;
    min-width: 0;
  }

  .kucica--zelena {
    --boja: var(--zelena);
    --boja-tamna: #162d22;
  }

  .kucica.otvoreno {
    z-index: 2;
  }

  /* Unutrašnjost: fotografija i naziv kolača */
  .kucica__unutra {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--krem-tamna);
    box-shadow: inset 0 0 0 var(--okvir-linija) var(--zlatna-55);
  }

  .kucica__unutra[hidden] {
    display: none;
  }

  .kucica__poveznica {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--tekst);
    text-decoration: none;
  }

  .kucica__poveznica::after {
    /* sjena udubljenja: unutrašnjost je "iza" vratašca */
    content: '';
    position: absolute;
    inset: 0;
    box-shadow:
      inset 0 0 0 var(--okvir-linija) var(--zlatna-55),
      inset 6px 0 14px -6px rgb(43 35 32 / 0.35);
    pointer-events: none;
  }

  .kucica__poveznica :global(.kucica__slika) {
    position: absolute;
    inset: 0;
    transition: transform 0.6s ease;
  }

  .kucica__poveznica:hover :global(.kucica__slika) {
    transform: scale(1.03);
  }

  /* Placeholder unutar kućice: naziv je već ispod, pa ga ne ponavljamo */
  .kucica__poveznica :global(.slika-placeholder__naziv) {
    display: none;
  }

  .kucica__poveznica :global(.slika-placeholder) {
    padding-bottom: 22cqh;
  }

  .kucica__naziv {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(0.3rem, 5cqmin, 0.9rem) clamp(0.35rem, 6cqmin, 1rem);
    background: rgb(247 240 228 / 0.94);
    border-top: var(--okvir-linija) solid var(--zlatna-55);
    font-family: var(--font-naslovi);
    font-style: italic;
    font-size: clamp(0.72rem, 9.5cqmin, 1.45rem);
    line-height: 1.15;
    text-align: center;
    text-wrap: balance;
    hyphens: auto;
  }

  .kucica__poveznica:focus-visible {
    outline-offset: -4px;
  }

  /* ─── Vratašca ──────────────────────────────────────────────── */

  .kucica__scena {
    position: absolute;
    inset: 0;
    perspective: 800cqw;
    perspective-origin: 50% 50%;
    pointer-events: none;
  }

  .kucica__vrata {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    pointer-events: auto;
    transform-origin: 0 50%;
    transform-style: preserve-3d;
    transition: transform 0.95s cubic-bezier(0.32, 0.72, 0.22, 1);
    -webkit-tap-highlight-color: transparent;
  }

  .kucica__vrata:focus-visible {
    outline: none;
  }

  .kucica__vrata:focus-visible .vrata__lice {
    outline: 2px solid var(--zlatna);
    outline-offset: 3px;
  }

  .vrata__lice,
  .vrata__nalicje {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .vrata__lice {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5cqmin;
    background:
      radial-gradient(ellipse 90% 80% at 50% 45%, rgb(255 255 255 / 0.06), transparent 70%),
      var(--boja);
    color: var(--krem);
    box-shadow: 0 1px 2px rgb(43 35 32 / 0.18);
  }

  /* Tanki zlatni okvir na vratašcima (odjek okvira stranice) */
  .vrata__lice::before {
    content: '';
    position: absolute;
    inset: clamp(4px, 5.5cqmin, 14px);
    border: var(--okvir-linija) solid var(--zlatna-55);
    pointer-events: none;
  }

  /* Ručkica */
  .vrata__lice::after {
    content: '';
    position: absolute;
    top: 50%;
    right: clamp(7px, 9cqmin, 22px);
    width: clamp(3px, 3cqmin, 7px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--zlatna);
    transform: translateY(-50%);
    opacity: 0.85;
  }

  .vrata__nalicje {
    transform: rotateY(180deg);
    background: linear-gradient(90deg, var(--krem-tamna), #e6d9c2);
    box-shadow: inset 0 0 0 var(--okvir-linija) var(--zlatna-55);
  }

  .vrata__broj {
    font-family: var(--font-naslovi);
    font-weight: 400;
    font-size: clamp(1.6rem, 46cqmin, 9rem);
    line-height: 0.9;
    font-variant-numeric: lining-nums proportional-nums;
    font-feature-settings: 'lnum' 1, 'pnum' 1;
    transition: opacity 0.3s ease;
  }

  .vrata__lice :global(.vrata__zvijezda) {
    width: clamp(10px, 11cqmin, 34px);
    height: auto;
    color: var(--zlatna);
    transition: opacity 0.3s ease;
  }

  /* Najava: istaknuta kućica s dvostrukim zlatnim okvirom */
  .kucica--uvod .vrata__lice {
    gap: 4cqmin;
  }

  .kucica--uvod .vrata__lice::before {
    inset: clamp(6px, 4.5cqmin, 16px);
    border-color: var(--zlatna);
    box-shadow:
      0 0 0 clamp(3px, 1.6cqmin, 6px) var(--boja),
      0 0 0 calc(clamp(3px, 1.6cqmin, 6px) + var(--okvir-linija)) var(--zlatna-55);
  }

  .kucica--uvod .vrata__broj {
    color: var(--zlatna);
    font-style: italic;
  }

  /* Zaključano: zvjezdica prigušena */
  .kucica.zakljucano .vrata__lice :global(.vrata__zvijezda) {
    opacity: 0.5;
  }

  /* Otključano: zvjezdica lagano titra, vratašca se odškrinu pod mišem */
  .kucica.otkljucano:not(.otvoreno) .vrata__lice :global(.vrata__zvijezda) {
    animation: titraj 3.6s ease-in-out infinite;
  }

  @media (hover: hover) {
    .kucica.otkljucano:not(.otvoreno) .kucica__vrata:hover {
      transform: rotateY(-14deg);
    }
  }

  /* Otvoreno: vratašca zakrenuta oko lijevog ruba */
  .kucica.otvoreno .kucica__vrata {
    transform: rotateY(-92deg);
    pointer-events: none;
  }

  .kucica.bez-animacije .kucica__vrata {
    transition: none;
  }

  /* Poruka za zaključana vratašca */
  .vrata__poruka {
    position: absolute;
    inset: auto 0 18cqmin;
    padding: 0 8cqmin;
    font-family: var(--font-tekst);
    font-weight: 700;
    font-size: clamp(0.56rem, 7.2cqmin, 0.8rem);
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--krem);
    text-align: center;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    pointer-events: none;
  }

  .kucica.poruka .vrata__poruka {
    opacity: 1;
    transform: none;
  }

  .kucica.poruka .vrata__broj {
    opacity: 0.25;
  }

  .kucica.poruka .vrata__lice :global(.vrata__zvijezda) {
    opacity: 0;
  }

  .kucica.poruka .kucica__vrata {
    animation: drmni 0.45s ease;
  }

  @keyframes titraj {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.3);
      opacity: 0.7;
    }
  }

  @keyframes drmni {
    0%,
    100% {
      transform: rotateY(0);
    }
    30% {
      transform: rotateY(-7deg);
    }
    60% {
      transform: rotateY(-2deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kucica__vrata,
    .kucica__poveznica :global(.kucica__slika) {
      transition: none;
    }

    .kucica.otkljucano:not(.otvoreno) .vrata__lice :global(.vrata__zvijezda),
    .kucica.poruka .kucica__vrata {
      animation: none;
    }

    .kucica.otkljucano:not(.otvoreno) .kucica__vrata:hover {
      transform: none;
    }
  }

  .kalendar__bez-js {
    margin: 1.5rem auto 0;
    max-width: var(--sirina-teksta);
    font-size: 0.9375rem;
    text-align: center;
    color: var(--tekst-blagi);
  }
</style>
