---
import Zaglavlje from '../components/Zaglavlje.astro';
import Zvijezda from '../components/Zvijezda.astro';
import Osnova from '../layouts/Osnova.astro';
---

<Osnova naslov="Stranica nije pronađena" opis="Ova stranica ne postoji. Vrati se na adventski kalendar božićnih kolača." bezIndeksa>
  <Zaglavlje slot="zaglavlje" />
  <section class="nema">
    <p class="nema__broj" aria-hidden="true">404</p>
    <h1 class="nema__naslov">Ova stranica <em>ne postoji</em></h1>
    <p class="nema__tekst">Možda je adresa krivo upisana. Svi kolači čekaju u kalendaru.</p>
    <a class="gumb" href="/">
      <Zvijezda />
      Natrag na kalendar
    </a>
  </section>
</Osnova>

<style>
  .nema {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 30rem;
    margin: clamp(2rem, 8vh, 5rem) auto 0;
    padding: 0 var(--rub);
    text-align: center;
  }

  .nema__broj {
    margin: 0;
    font-family: var(--font-naslovi);
    font-size: clamp(4.5rem, 20vw, 7rem);
    line-height: 1;
    color: var(--zlatna);
    font-variant-numeric: lining-nums;
    font-feature-settings: 'lnum' 1;
  }

  .nema__naslov {
    font-size: clamp(1.8rem, 7vw, 2.5rem);
  }

  .nema__naslov em {
    color: var(--crvena);
  }

  .nema__tekst {
    margin: 0;
    color: var(--tekst-blagi);
  }
</style>
