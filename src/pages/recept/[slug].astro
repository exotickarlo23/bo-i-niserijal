---
/**
 * Stranica recepta: /recept/[slug]/
 *
 * Ako je recept objavljen u trenutku builda, sadržaj je izravno u HTML-u.
 * Ako nije, sadržaj čeka u <template> i otključava ga mala skripta kad stigne
 * datum (po zagrebačkom vremenu) ili kad je u adresi ?preview=1.
 * Do tada se prikazuje ljubazna poruka "Ovaj kolač stiže X. prosinca".
 */
import { render } from 'astro:content';
import ReceptSadrzaj from '../../components/ReceptSadrzaj.astro';
import Zakljucano from '../../components/Zakljucano.astro';
import Zaglavlje from '../../components/Zaglavlje.astro';
import Osnova from '../../layouts/Osnova.astro';
import { jeObjavljeno } from '../../lib/datumi';
import { dohvatiEpizode, dohvatiRecepte, type Recept } from '../../lib/epizode';
import { opisRecepta, receptJsonLd } from '../../lib/recept';
import { izrez, pronadiSliku } from '../../lib/slike';
import { pripremiVidee } from '../../lib/video';

export async function getStaticPaths() {
  const recepti = await dohvatiRecepte();
  return recepti.map((recept) => ({ params: { slug: recept.data.slug }, props: { recept } }));
}

interface Props {
  recept: Recept;
}

const { recept } = Astro.props;
const d = recept.data;
const site = Astro.site ?? new URL(Astro.url.origin);

const [epizode, recepti] = await Promise.all([dohvatiEpizode(), dohvatiRecepte()]);
const i = epizode.findIndex((e) => e.vrsta === 'recept' && e.kljuc === d.slug);
const prethodni = epizode[i - 1];
const sljedeci = epizode[i + 1];
const redniBroj = recepti.findIndex((r) => r.data.slug === d.slug) + 1;

const { Content } = await render(recept);
const videi = pripremiVidee(d.video);
const slika = pronadiSliku(d.slika || `/slike/${d.slug}.jpg`);
const og = slika ? await izrez(slika, 1200, 630) : null;
const jsonLd = await receptJsonLd(recept, site, slika, videi);
const objavljeno = jeObjavljeno(d.datum);
const jsonUSkripti = (podaci: unknown) => JSON.stringify(podaci).replace(/</g, '\\u003c');
---

<Osnova
  naslov={d.naziv}
  opis={opisRecepta(recept)}
  slikaOg={og ? { ...og, alt: d.slikaAlt || d.naziv } : null}
  tip="article"
  objavljeno={d.datum}
  jsonLd={objavljeno ? jsonLd : null}
>
  <Zaglavlje slot="zaglavlje" />

  {
    objavljeno ? (
      <ReceptSadrzaj
        recept={recept}
        redniBroj={redniBroj}
        ukupno={recepti.length}
        videi={videi}
        prethodni={prethodni}
        sljedeci={sljedeci}
      >
        <Content />
      </ReceptSadrzaj>
    ) : (
      <>
        <template id="sadrzaj-predlozak">
          <ReceptSadrzaj
            recept={recept}
            redniBroj={redniBroj}
            ukupno={recepti.length}
            videi={videi}
            prethodni={prethodni}
            sljedeci={sljedeci}
          >
            <Content />
          </ReceptSadrzaj>
        </template>
        {jsonLd && (
          <template id="jsonld-predlozak">
            <script is:inline type="application/ld+json" set:html={jsonUSkripti(jsonLd)} />
          </template>
        )}
        <script is:inline data-datum={d.datum}>
          (function (s) {
            var d = window.dvanaest;
            if (!d || !d.otkljucano(s.getAttribute('data-datum'))) return;
            var t = document.getElementById('sadrzaj-predlozak');
            s.parentNode.insertBefore(t.content.cloneNode(true), s);
            var j = document.getElementById('jsonld-predlozak');
            if (j) document.head.appendChild(j.content.cloneNode(true));
            document.documentElement.classList.add('otkljucano');
          })(document.currentScript);
        </script>
        <Zakljucano datum={d.datum} naslov="Ovaj kolač stiže" />
      </>
    )
  }
</Osnova>
